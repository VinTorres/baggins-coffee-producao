{
  "name": "baggins-coffee",
  "version": "1.0.0",
  "private": true,
  "description": "Baggins Coffee: guia de métodos, calculadora e despensa de cafés com PostgreSQL",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "db:setup": "node --env-file=.env db/setup.js",
    "db:migrate": "node --env-file=.env db/migrate.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
